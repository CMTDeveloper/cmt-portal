// =============================================================================
//  BASELINE EXPORT of the LIVE prod ruleset on chinmaya-setu-715b8.
//  Captured 2026-07-26 from the Firebase console by CMT Developer.
//
//  ⚠️ NOT WIRED TO ANY DEPLOY, ON PURPOSE. `firebase.json` points at
//  `firestore.rules` (the UAT deny-all). The `.baseline` extension keeps this
//  file from ever being mistaken for a deploy target.
//
//  It exists so that (a) prod finally has a rollback artifact in version
//  control, which it did not before, and (b) any future prod ruleset can be
//  diffed against what was actually live rather than against nothing.
//
//  Do NOT edit this file to change prod. Copy it, edit the copy, diff, and
//  deploy the copy only with the door-app owner confirming its access surface
//  is unchanged.
// =============================================================================
//
//  WHAT THIS RULESET ACTUALLY GRANTS
//
//  Firestore allow rules are ADDITIVE (a request is permitted if ANY matching
//  rule allows it), so the `match /{document=**} { allow read, write: if false }`
//  block grants nothing and forbids nothing. Its practical effect is
//  documentation: everything not named below is denied, which is Firestore's
//  default anyway.
//
//  Reachable by the client SDK: `family-check-ins/**`, `guest-families/**`,
//  and `verification_codes/*`. NOTHING ELSE.
//
//  → CORRECTION to the 2026-07-25 runbook entry, which recorded that "pledges
//    is client-writable in prod" and treated that as a launch blocker. It is
//    not. `pledges` and `pledge_secrets` match no rule here, so they are
//    already denied. P5 needs no additional prod deny for them.
//
//  ⚠️ FINDING - `verification_codes` create is UNAUTHENTICATED. See
//  docs/runbooks/production-cutover-checklist.md §14 (2026-07-26) for the full
//  analysis and the fix. Do not treat this file as a clean bill of health.
// =============================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }

    function isTeacher() {
      return request.auth.token.role == 'teacher';
    }

    function isFamily() {
      return request.auth.token.role == 'family';
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    match /family-check-ins/{familyId}/{document=**} {
      allow read: if request.auth != null && (
        isAdmin() ||
        isTeacher() ||
        (isFamily() && request.auth.token.familyId == familyId)
      );
      allow write: if request.auth != null && (
        isAdmin() ||
        isTeacher() ||
        (isFamily() && request.auth.token.familyId == familyId)
      );
    }

    match /guest-families/{familyId}/{document=**} {
      allow read: if request.auth != null && (
        isAdmin() ||
        isTeacher() ||
        request.auth.uid == familyId
      );
      allow write: if request.auth != null && (
        isAdmin() ||
        isTeacher()
      );
    }

    // ⚠️ `create` has NO `request.auth` condition: any unauthenticated caller
    // holding the public Firebase API key may create a document at any id in
    // this collection. `hasAll` requires three keys but does not forbid others.
    match /verification_codes/{codeId} {
      allow create: if request.resource.data.keys().hasAll(['code', 'expires', 'type'])
        && request.resource.data.expires is timestamp
        && (request.resource.data.type == 'email' || request.resource.data.type == 'phone');
      allow read, delete: if request.auth != null && (isAdmin() || isTeacher());
    }
  }
}
